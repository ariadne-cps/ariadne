@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

find_dependency(GMP)
find_dependency(MPFR)

set(ARIADNE_WITH_CAIRO @CAIRO_FOUND@)
if(ARIADNE_WITH_CAIRO)
  find_dependency(Cairo)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AriadneTargets.cmake")
